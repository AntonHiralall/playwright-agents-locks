{
  "name": "playwright-agents-and-locks",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Playwright framework demo: heuristic agents, file locks, Allure reporting",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "allure:generate": "npx allure generate ./allure-results --output ./allure-report",
    "allure:open": "npx allure open ./allure-report",
    "allure:serve": "npx allure generate ./allure-results --output ./allure-report --open",
    "report": "npm test && npm run allure:serve"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^22.13.10",
    "allure": "^3.0.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "typescript": "^5.8.2"
  }
}
